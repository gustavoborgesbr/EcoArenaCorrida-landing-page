rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gustavo.borges.estudante@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Event Configuration - Public read for race info, validated write from organizer panel
    match /event_config/{configId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.eventName is string &&
        request.resource.data.whatsAppNumber is string &&
        request.resource.data.pixKey is string
      );
    }

    // Participants Collection - Public can register and view for ticket lookup
    // Organizer panel can update status, confirm payment, or delete
    match /participants/{participantId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['pending_payment', 'confirmed'] &&
                       request.resource.data.fullName is string &&
                       request.resource.data.fullName.size() > 2 &&
                       request.resource.data.cpf is string &&
                       request.resource.data.phone is string;
      allow update: if isAdmin() || (
        request.resource.data.status in ['pending_payment', 'confirmed', 'cancelled'] &&
        request.resource.data.fullName is string
      );
      allow delete: if true;
    }

    // Analytics Stats Collection - Public can increment funnel metrics (page views, clicks, WhatsApp redirects)
    match /analytics_stats/{statId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Audit logs - Financial and management audit trail for organizer panel
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.action is string &&
                       request.resource.data.details is string &&
                       request.resource.data.timestamp is string;
      allow update, delete: if isAdmin();
    }

    // Admins profile collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

